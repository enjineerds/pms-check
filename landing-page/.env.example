# Web app URL from the Google Apps Script deployment (see google-apps-script/README.md).
# The sign-up form POSTs { email, source } to it as form data.
PUBLIC_WAITLIST_ENDPOINT=

# PostHog project API key (public) and host. Leave key empty to disable tracking.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
