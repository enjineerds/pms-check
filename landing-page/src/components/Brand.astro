---
// Live-text lockup with the official proportions: cap height 0.36 and gap 0.22 of the tile.
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
const fontSize = ((size * 0.36) / 0.745).toFixed(2);
const gap = (size * 0.22).toFixed(2);
---

<span class="brand-lockup" style={`--tile:${size}px;--name:${fontSize}px;--gap:${gap}px`}>
  <img src="/brand/pms-check-icon-small.svg" width={size} height={size} alt="" />
  <span class="brand-name">PMS Check</span>
</span>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--gap);
    color: var(--color-ink);
  }
  img {
    display: block;
    width: var(--tile);
    height: var(--tile);
    flex: none;
  }
  .brand-name {
    font-size: var(--name);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
