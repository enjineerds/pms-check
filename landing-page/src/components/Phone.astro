---
/**
 * Every phone on the page renders at one size: a 190×320 screen drawn at 1.7×
 * (323×544 on screen). Size lives here, not at the call site, so mockups can't drift apart.
 */
interface Props {
  /** Text alternative describing what the screen shows. */
  label: string;
}
const { label } = Astro.props;
---

<div class="phone" role="img" aria-label={label}>
  <div class="screen"><slot /></div>
</div>

<style>
  .phone {
    --phone-w: 190px;
    --phone-h: 320px;
    --phone-scale: 1.7;
    width: var(--phone-w);
    height: var(--phone-h);
    zoom: var(--phone-scale);
    border: 5px solid #181a20;
    border-bottom: 0;
    border-radius: 30px 30px 0 0;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 30px 50px -24px rgba(10, 12, 30, 0.5);
    flex: none;
  }
  .screen {
    height: 100%;
    padding: 12px 11px;
    font-size: 8px;
    line-height: 1.35;
    color: var(--color-ink);
  }
</style>
