---
import Icon from './Icon.astro';

type Kind = 'verdict' | 'pick' | 'scan' | 'advisor' | 'reason';
interface Props {
  kind: Kind;
}
const { kind } = Astro.props;

const cars = [
  ['Toyota Vios', '1.3 XE, 1.3 XLE, 1.5 G · 2014 to 2025'],
  ['Toyota Wigo', '1.0 E, 1.0 G · 2017 to 2025'],
  ['Mitsubishi Mirage', '1.2 GLX, 1.2 GLS · 2013 to 2025'],
  ['Honda City', '1.5 S, 1.5 V, 1.5 RS · 2014 to 2025'],
  ['Suzuki Ertiga', '1.5 GA, 1.5 GL, 1.5 GLX · 2019 to 2025'],
  ['Nissan Almera', '1.0 Turbo E, 1.0 Turbo VL · 2020 to 2025'],
];
const receipt = [
  ['CHANGE OIL + OIL FILTER', '2,450.00'],
  ['TIRE ROTATION', '600.00'],
  ['BRAKE INSPECTION & CLEANING', '350.00'],
  ['CABIN AIR FILTER', '750.00'],
  ['ENGINE FLUSH', '1,800.00'],
  ['FUEL INJECTOR CLEANING', '2,200.00'],
];
---

{
  kind === 'verdict' && (
    <div class="s">
      <div class="top">
        <span class="back"><Icon name="chevron-left" stroke={2.8} /></span>
        <div>
          <b>10,000 km service</b>
          <small>Bayan Motors · Today</small>
        </div>
      </div>
      <h4>Say no to ₱8,800 of this quote.</h4>
      <p class="sub">The casa quoted ₱14,000 for your Vios.</p>
      <div class="tiles">
        <div class="tile"><i class="ic yes"><Icon name="check" stroke={3.2} /></i><b>₱3,400</b><span>Say yes</span></div>
        <div class="tile"><i class="ic ask"><Icon name="question" stroke={3} /></i><b>₱1,800</b><span>Ask first</span></div>
        <div class="tile on"><i class="ic no"><Icon name="x" stroke={3.2} /></i><b>₱8,800</b><span>Say no</span></div>
      </div>
      <p class="note">
        <b class="amber">Ask first</b> means reasonable, but not due yet. Ask to see it.
      </p>
      <div class="cta">Show this to the advisor</div>
      <div class="card">
        <div class="cardhead"><b class="green">Say yes</b><span>All in Toyota's schedule</span></div>
        <div class="row"><i class="ic yes sm"><Icon name="check" stroke={3.2} /></i><span>Change oil + oil filter</span><em>₱2,450<small class="green">Say yes</small></em></div>
        <div class="row"><i class="ic yes sm"><Icon name="check" stroke={3.2} /></i><span>Tire rotation</span><em>₱600<small class="green">Say yes</small></em></div>
        <div class="row"><i class="ic yes sm"><Icon name="check" stroke={3.2} /></i><span>Brake inspection</span><em>₱350<small class="green">Say yes</small></em></div>
        <div class="cardhead"><b class="amber">Ask first</b><span>Due at 20,000 km</span></div>
        <div class="row"><i class="ic ask sm"><Icon name="question" stroke={3} /></i><span>Cabin air filter</span><em>₱750<small class="amber">Ask first</small></em></div>
      </div>
    </div>
  )
}

{
  kind === 'pick' && (
    <div class="s">
      <div class="top">
        <span class="back"><Icon name="chevron-left" stroke={2.8} /></span>
        <div>
          <b>Pick your car</b>
          <small>Step 1 of 4</small>
        </div>
      </div>
      <h4>Which car do you drive?</h4>
      <div class="search">Search your model</div>
      <div class="card list">
        {cars.map(([n, d]) => (
          <div class="row car">
            <i class="car-ic"><Icon name="car" stroke={2} /></i>
            <span>
              <b>{n}</b>
              <small>{d}</small>
            </span>
            <u><Icon name="chevron-right" stroke={2.6} /></u>
          </div>
        ))}
      </div>
      <p class="type">Don't see your car? <b>Type it in</b></p>
    </div>
  )
}

{
  kind === 'scan' && (
    <div class="s scan">
      <div class="top">
        <span class="back"><Icon name="chevron-left" stroke={2.8} /></span>
        <div>
          <b>Scan the quote</b>
          <small>Fit the whole quote in the frame</small>
        </div>
      </div>
      <div class="hold"><span class="steady"><i class="dot"></i>Hold steady…</span><span class="flash"><Icon name="flash" stroke={2.2} />Flash off</span></div>
      <div class="frame">
      <div class="paper">
        <b>BAYAN MOTORS CORP.</b>
        <small>SERVICE QUOTATION · VIOS 1.3 XLE · 10,240 KM</small>
        {receipt.map(([n, p]) => (
          <div class="rrow"><span>{n}</span><span>{p}</span></div>
        ))}
        <div class="rrow total"><span>TOTAL</span><span>14,000.00</span></div>
      </div>
      </div>
    </div>
  )
}

{
  kind === 'advisor' && (
    <div class="s">
      <div class="top">
        <span class="back"><Icon name="chevron-left" stroke={2.8} /></span>
        <div>
          <b>Show the advisor</b>
          <small>Toyota Vios 1.3 XLE · 10,240 km</small>
        </div>
      </div>
      <h4 class="big">Please do only these for my 10,000 km PMS.</h4>
      <div class="darkcard">
        <div class="drow"><span>Change oil + oil filter</span><b>₱2,450</b></div>
        <div class="drow"><span>Tire rotation</span><b>₱600</b></div>
        <div class="drow"><span>Brake inspection</span><b>₱350</b></div>
        <div class="pay"><span>I will pay</span><strong>₱3,400</strong></div>
      </div>
      <p class="lbl amber">Show me first</p>
      <div class="row"><i class="ic ask sm"><Icon name="question" stroke={3} /></i><span>Cabin air filter</span><em>₱750<small class="amber">Ask first</small></em></div>
      <p class="lbl red">Not today, thank you</p>
      <div class="row"><i class="ic no sm"><Icon name="x" stroke={3.2} /></i><span>Engine flush</span><em>₱1,800<small class="red">Say no</small></em></div>
      <div class="row"><i class="ic no sm"><Icon name="x" stroke={3.2} /></i><span>Fuel injector cleaning</span><em>₱2,200<small class="red">Say no</small></em></div>
    </div>
  )
}

{
  kind === 'reason' && (
    <div class="s">
      <div class="top">
        <span class="back"><Icon name="chevron-left" stroke={2.8} /></span>
        <div>
          <b>Engine flush</b>
          <small>₱1,800 · On your quote</small>
        </div>
      </div>
      <h4>Not in your Vios's schedule. You can say no.</h4>
      <div class="darkcard say">
        <div class="saytop"><span>Say this</span><span class="copy"><Icon name="copy" stroke={2.4} />Copy</span></div>
        <p>“Just the items in the manufacturer's 10,000 km PMS, please. No engine flush.”</p>
      </div>
      <p class="lbl">What the manual says</p>
      <p class="body">Toyota's 10,000 km service lists an oil and filter change, not a flush.</p>
      <p class="src">Source: Vios owner's manual, 2025 · <u>Report a mistake</u></p>
      <p class="lbl">Why they offer it</p>
      <p class="body">It's a high-margin add-on. A flush only matters on engines with heavy sludge, not a car at 10,240 km.</p>
      <div class="callout"><b>Say yes only if</b> they show you sludge or the engine light is on.</div>
    </div>
  )
}

<style is:global>
  .s .top {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-bottom: 8px;
  }
  .s .top b {
    display: block;
    font-size: 8px;
  }
  .s .top small {
    display: block;
    font-size: 6.5px;
    color: var(--color-ink-faint);
  }
  .s .back {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-ground);
    display: grid;
    place-items: center;
    font-size: 11px;
    flex: none;
  }
  .s h4 {
    margin: 0 0 4px;
    font-size: 15px;
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 700;
  }
  .s h4.big {
    font-size: 14px;
  }
  .s .sub {
    font-size: 7px;
    color: var(--color-ink-faint);
    margin-bottom: 7px;
  }
  .s .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .s .tile {
    border-radius: 9px;
    background: #fff;
    border: 1px solid var(--color-line);
    box-shadow: 0 4px 10px -6px rgba(30, 40, 90, 0.3);
    padding: 6px 4px;
    text-align: center;
    display: grid;
    gap: 1px;
    justify-items: center;
  }
  .s .tile b {
    font-size: 8px;
  }
  .s .tile span {
    font-size: 6.5px;
    color: var(--color-ink-soft);
  }
  .s .tile.on {
    background: var(--gloss);
    border-color: transparent;
    color: #fff;
  }
  .s .tile.on span {
    color: #fff;
  }
  .s .ic {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 6px;
    font-style: normal;
    font-weight: 800;
    flex: none;
  }
  .s .ic :global(svg),
  .s .back :global(svg),
  .s .car-ic :global(svg) {
    width: 62%;
    height: 62%;
  }
  .s .ic.sm {
    width: 13px;
    height: 13px;
    font-size: 7px;
  }
  .s .ic.yes {
    background: var(--color-required-bg);
    color: var(--color-required);
  }
  .s .ic.ask {
    background: var(--color-optional-bg);
    color: var(--color-optional);
  }
  .s .ic.no {
    background: var(--color-skip-bg);
    color: var(--color-skip);
  }
  .s .note {
    font-size: 6.5px;
    color: var(--color-ink-soft);
    margin: 6px 0;
  }
  .s .amber {
    color: var(--color-optional);
  }
  .s .green {
    color: var(--color-required);
  }
  .s .red {
    color: var(--color-skip);
  }
  .s .cta {
    background: var(--gloss);
    color: #fff;
    text-align: center;
    border-radius: 999px;
    font-weight: 700;
    font-size: 7.5px;
    padding: 6px;
    margin-bottom: 7px;
  }
  .s .card {
    border: 1px solid var(--color-line);
    border-radius: 9px;
    padding: 5px 6px;
    background: #fff;
    box-shadow: 0 6px 14px -10px rgba(30, 40, 90, 0.3);
  }
  .s .cardhead {
    display: flex;
    justify-content: space-between;
    font-size: 6.5px;
    margin: 3px 0;
  }
  .s .cardhead span {
    color: var(--color-ink-faint);
  }
  .s .row {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 3px 0;
    font-size: 7.5px;
    font-weight: 600;
  }
  .s .row span {
    flex: 1;
  }
  .s .row em,
  .s .rrow,
  .s .drow b,
  .s .pay strong,
  .s .tile b {
    font-variant-numeric: tabular-nums;
  }
  .s .row em {
    font-style: normal;
    font-weight: 700;
    text-align: right;
    display: grid;
  }
  .s .row em small {
    font-size: 5.5px;
    font-weight: 700;
  }
  .s .search {
    border: 1px solid var(--color-line);
    border-radius: 7px;
    padding: 5px 7px;
    font-size: 7px;
    color: var(--color-ink-faint);
    margin: 6px 0;
  }
  .s .list .row {
    border-bottom: 1px solid var(--color-line);
    padding: 4px 0;
  }
  .s .list .row:last-child {
    border: 0;
  }
  .s .car b {
    display: block;
    font-size: 7.5px;
  }
  .s .car small {
    display: block;
    font-size: 5.5px;
    color: var(--color-ink-faint);
    font-weight: 500;
  }
  .s .car-ic {
    font-style: normal;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-ground);
    display: grid;
    place-items: center;
    font-size: 8px;
    flex: none;
  }
  .s .car u {
    text-decoration: none;
    color: var(--color-ink-faint);
  }
  .s .type {
    text-align: center;
    font-size: 6.5px;
    color: var(--color-ink-faint);
    margin-top: 6px;
  }
  .s .type b {
    color: var(--color-ink);
  }
  .s.scan {
    display: flex;
    flex-direction: column;
    height: calc(100% + 24px);
    background: #f4f5f8;
    margin: -12px -11px;
    padding: 12px 11px;
  }
  .s .hold {
    display: flex;
    justify-content: space-between;
    font-size: 6.5px;
    color: var(--color-required);
    margin-bottom: 6px;
  }
  .s .steady,
  .s .flash,
  .s .copy {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .s .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .s .hold .flash {
    color: var(--color-ink);
    background: #fff;
    border-radius: 999px;
    padding: 1px 5px;
  }
  /* Viewfinder: corner brackets around the quote, filling the screen */
  .s .frame {
    flex: 1;
    display: grid;
    place-items: center;
    position: relative;
    padding: 10px 6px;
    background:
      linear-gradient(var(--color-ink), var(--color-ink)) top left / 14px 2px,
      linear-gradient(var(--color-ink), var(--color-ink)) top left / 2px 14px,
      linear-gradient(var(--color-ink), var(--color-ink)) top right / 14px 2px,
      linear-gradient(var(--color-ink), var(--color-ink)) top right / 2px 14px,
      linear-gradient(var(--color-ink), var(--color-ink)) bottom left / 14px 2px,
      linear-gradient(var(--color-ink), var(--color-ink)) bottom left / 2px 14px,
      linear-gradient(var(--color-ink), var(--color-ink)) bottom right / 14px 2px,
      linear-gradient(var(--color-ink), var(--color-ink)) bottom right / 2px 14px;
    background-repeat: no-repeat;
  }
  .s .paper {
    width: 100%;
    background: #fff;
    border-radius: 4px;
    padding: 8px 7px;
    font-size: 5.5px;
    transform: rotate(-1.5deg);
    box-shadow: 0 8px 18px -8px rgba(0, 0, 0, 0.3);
  }
  .s .paper b {
    display: block;
    font-size: 6.5px;
  }
  .s .paper small {
    display: block;
    font-size: 4.5px;
    color: var(--color-ink-faint);
    margin-bottom: 6px;
  }
  .s .rrow {
    display: flex;
    justify-content: space-between;
    padding: 2px 0;
  }
  .s .rrow.total {
    border-top: 1px solid var(--color-ink);
    margin-top: 3px;
    font-weight: 800;
  }
  .s .darkcard {
    background: var(--gloss);
    color: #fff;
    border-radius: 9px;
    padding: 7px 8px;
    margin: 7px 0;
  }
  .s .drow {
    display: flex;
    justify-content: space-between;
    font-size: 7px;
    padding: 2.5px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .s .pay {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 5px;
    font-size: 7px;
  }
  .s .pay strong {
    font-size: 16px;
    letter-spacing: -0.03em;
  }
  .s .lbl {
    font-size: 6.5px;
    font-weight: 700;
    margin: 6px 0 2px;
  }
  .s .darkcard.say {
    font-size: 7px;
  }
  .s .saytop {
    display: flex;
    justify-content: space-between;
    font-size: 6.5px;
    color: #cfd2d8;
    margin-bottom: 4px;
  }
  .s .copy {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 0 5px;
  }
  .s .darkcard.say p {
    font-size: 9px;
    font-weight: 700;
    line-height: 1.2;
  }
  .s .body {
    font-size: 6.5px;
    color: var(--color-ink-soft);
  }
  .s .src {
    font-size: 5.5px;
    color: var(--color-ink-faint);
    margin: 2px 0;
  }
  .s .callout {
    background: var(--color-optional-bg);
    border-radius: 7px;
    padding: 5px 6px;
    font-size: 6.5px;
    margin-top: 6px;
  }
</style>
